PORT=5000

# Local frontend origin — change to your deployed frontend URL in production
# e.g. CLIENT_ORIGIN=https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# MongoDB — local or Atlas
# Atlas format: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/krishi_credit?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/krishi_credit

JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
JWT_EXPIRES_IN=7d
MAX_UPLOAD_MB=15

# Set to "production" on Render/Railway/VPS
NODE_ENV=development

# Used by npm run seed — creates the first owner account
SEED_OWNER_NAME=Owner
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=owner12345
