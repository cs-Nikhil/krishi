PORT=5000
HOST=0.0.0.0
TRUST_PROXY=1
HTTP_LOGGING=true

# Comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/krishi_credit

# Auth
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Uploads
MAX_UPLOAD_MB=15

# Set to "production" in production environments
NODE_ENV=development

# Used by npm run seed — creates the first owner account
SEED_OWNER_NAME=Owner
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=owner12345
