PORT=5000
HOST=0.0.0.0
TRUST_PROXY=1
HTTP_LOGGING=true

# Allowed frontend origins (comma-separated)
CLIENT_ORIGINS=http://localhost:5173,https://your-production-frontend.vercel.app

# Primary production frontend
FRONTEND_URL=https://your-production-frontend.vercel.app

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/krishi_credit

# Authentication
JWT_SECRET=replace_with_secure_random_secret_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Upload limits
MAX_UPLOAD_MB=15

# Environment
NODE_ENV=development

# Seed owner account
SEED_OWNER_NAME=Owner
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=owner12345
